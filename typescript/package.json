{
  "name": "@indykite/delegated-token",
  "version": "0.0.0",
  "description": "IndyKite delegated token propagation for AI agents and MCP servers",
  "keywords": [
    "indykite",
    "delegated-token",
    "token-propagation",
    "a2a",
    "mcp",
    "agents"
  ],
  "homepage": "https://github.com/indykite/indykite-delegated-token/tree/master/typescript#readme",
  "bugs": "https://github.com/indykite/indykite-delegated-token/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/indykite/indykite-delegated-token.git",
    "directory": "typescript"
  },
  "license": "Apache-2.0",
  "author": "IndyKite <develop@indykite.com>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./express": {
      "types": "./dist/server/express.d.ts",
      "default": "./dist/server/express.js"
    },
    "./hono": {
      "types": "./dist/server/hono.d.ts",
      "default": "./dist/server/hono.js"
    },
    "./mcp-handler": {
      "types": "./dist/server/mcp-handler.d.ts",
      "default": "./dist/server/mcp-handler.js"
    },
    "./fetch": {
      "types": "./dist/client/fetch.d.ts",
      "default": "./dist/client/fetch.js"
    },
    "./a2a": {
      "types": "./dist/client/a2a.d.ts",
      "default": "./dist/client/a2a.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "prepack": "pnpm run clean && pnpm run build",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:frameworks": "vitest run --project frameworks",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@a2a-js/sdk": "^1.3.0",
    "@types/express": ">=4.17",
    "express": ">=4.18",
    "hono": "^4.0.0",
    "mcp-handler": ">=1.1.0"
  },
  "peerDependenciesMeta": {
    "@a2a-js/sdk": {
      "optional": true
    },
    "@types/express": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "mcp-handler": {
      "optional": true
    }
  },
  "devDependencies": {
    "@a2a-js/sdk": "1.3.0",
    "@ai-sdk/mcp": "2.0.104",
    "@ai-sdk/provider": "4.0.39",
    "@eslint/js": "10.0.1",
    "@google/adk": "2.5.0",
    "@hono/node-server": "2.1.8",
    "@langchain/core": "1.5.1",
    "@langchain/langgraph": "1.7.5",
    "@langchain/mcp-adapters": "2.0.3",
    "@mastra/core": "1.85.0",
    "@mastra/hono": "1.7.27",
    "@mastra/mcp": "2.10.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/express": "2.0.2",
    "@modelcontextprotocol/hono": "2.0.2",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@openai/agents": "0.22.0",
    "@opentelemetry/api": "1.9.1",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@vercel/otel": "2.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "ai": "7.0.181",
    "eslint": "10.14.0",
    "express": "5.3.0",
    "hono": "4.13.19",
    "mcp-handler": "2.4.0",
    "mcp-handler-v1": "npm:mcp-handler@1.1.0",
    "next": "16.4.6",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  },
  "packageManager": "pnpm@11.11.0"
}
