{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rootDir": ".",
    "outDir": "dist",
    "paths": {
      "@indykite/delegated-token": ["./src/index.ts"],
      "@indykite/delegated-token/a2a": ["./src/client/a2a.ts"],
      "@indykite/delegated-token/express": ["./src/server/express.ts"],
      "@indykite/delegated-token/fetch": ["./src/client/fetch.ts"],
      "@indykite/delegated-token/hono": ["./src/server/hono.ts"],
      "@indykite/delegated-token/mcp-handler": ["./src/server/mcp-handler.ts"]
    }
  },
  "include": ["src", "test", "examples", "*.config.ts"]
}
